# Copy this file to .env only when you need to override Docker Compose defaults.
# The default binding is localhost-only for use behind Nginx, Caddy, Traefik,
# or another reverse proxy on the same host.
#
# Only use STEAM_BEE_BIND=0.0.0.0 on a trusted LAN or VPN. Fresh instances also
# require the one-time token printed in the container logs and /data/setup.token.
STEAM_BEE_BIND=127.0.0.1
STEAM_BEE_PORT=3000
# STEAM_BEE_IMAGE=ghcr.io/ill-yes/steam-bee:1.0.0

# Set both to true when SteamBee is served through HTTPS behind a reverse proxy.
TRUST_PROXY=false
COOKIE_SECURE=false

LOG_LEVEL=info
LOG_REQUESTS=true
LOG_QUIET_REQUESTS=true

# Optional fixed setup token for automated provisioning. When omitted, SteamBee
# generates /data/setup.token with mode 0600 and prints the token once per start
# until setup succeeds. Never commit a real token.
# SETUP_TOKEN=replace-with-at-least-16-random-characters

# Set to 0 to disable automatic event cleanup.
EVENT_RETENTION_DAYS=90

# Docker json-file log rotation.
DOCKER_LOG_MAX_SIZE=10m
DOCKER_LOG_MAX_FILE=3
