{
  "name": "steam-bee",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "description": "Self-hosted operations console for managing your own Steam accounts.",
  "homepage": "https://github.com/ill-yes/steam-bee#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ill-yes/steam-bee.git"
  },
  "bugs": {
    "url": "https://github.com/ill-yes/steam-bee/issues"
  },
  "keywords": [
    "docker",
    "self-hosted",
    "steam"
  ],
  "type": "module",
  "packageManager": "pnpm@12.15.0+sha512.b3951d6d6ff4a9f13dc7cf56cd28d2b8eb37dbcc9c68e52e1e1191873ea9f82a017287ab50baadc5ccc494f036c67c0e47eb13608c2fa36f47711b61ea128e61",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm release:source:check && pnpm contracts:build && pnpm -r check",
    "compose:check": "node scripts/check-compose-parity.mjs",
    "compose:test": "node --test scripts/compose-*.test.mjs",
    "crash-recovery:test": "node --test scripts/docker-oom-events.test.mjs",
    "unraid:check": "node scripts/check-unraid-template.mjs",
    "contracts:build": "pnpm --filter @steam-bee/contracts build",
    "dev": "pnpm --filter @steam-bee/server dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hygiene:test": "node --test scripts/repository-hygiene.test.mjs",
    "release:plan": "node scripts/plan-release.mjs",
    "release:source:check": "node scripts/check-release-source.mjs",
    "release:test": "node --test scripts/release-metadata.test.mjs",
    "test": "pnpm release:test && pnpm compose:test && pnpm hygiene:test && pnpm crash-recovery:test && pnpm contracts:build && pnpm -r test"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "prettier": "^3.9.10",
    "typescript": "^7.0.2"
  }
}
